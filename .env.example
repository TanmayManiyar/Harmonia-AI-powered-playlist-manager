YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model (2.5-flash-lite has a generous free tier)
GEMINI_MODEL=gemini-2.5-flash-lite
# REQUIRED: a long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb://127.0.0.1:27017/playlist-manager
PORT=5000
# In production set these to your deployed URLs
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth/callback
